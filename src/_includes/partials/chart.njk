{#
  A bar chart built from data, not from markup.

  Three things make this a research chart rather than a decoration:

  1. The real content is a <table>. It is in the DOM for every reader,
     carries the same numbers, and is what a screen reader announces. The
     bars are drawn from it and are aria-hidden.
  2. Bar length is `value / scaleMax`, computed here. Nothing is hand-set,
     so a value edited in the admin panel cannot disagree with its bar.
  3. Attribution is visible. When no source is recorded the chart says so
     with the same placeholder chip used elsewhere, rather than presenting
     an unsourced figure as if it were sourced.

  The percentage is carried on `data-value` and applied by script via
  CSSOM, never as an inline `style` attribute. That is what lets the public
  CSP run with a bare `style-src 'self'`.
#}
<figure class="chart" id="{{ chart.id }}" data-reveal="up">
  <figcaption class="chart-head">
    <h2>{{ chart.title }}</h2>
  </figcaption>

  <table class="chart-table">
    <caption class="sr-only">{{ chart.title }}. Values in {{ chart.unit | default("units") }}.</caption>
    <thead>
      <tr><th scope="col">Series</th><th scope="col">Value</th></tr>
    </thead>
    <tbody>
    {%- for s in chart.series %}
      <tr>
        <th scope="row">{{ s.label }}</th>
        <td>{{ s.display }}</td>
      </tr>
    {%- endfor %}
    </tbody>
  </table>

  <div class="chart-bars" aria-hidden="true">
  {%- for s in chart.series %}
    <div class="bar-row">
      <span class="bar-label">{{ s.label }}</span>
      <div class="bar-track">
        <div class="bar-fill{% if s.muted %} is-muted{% endif %}"
             data-value="{{ (s.value / chart.scaleMax * 100) | round(2) }}"></div>
      </div>
      <span class="bar-value">{{ s.display }}</span>
    </div>
  {%- endfor %}
  </div>

  {%- if chart.note %}
  <p class="chart-note">{{ chart.note }}</p>
  {%- endif %}

  <p class="chart-source">
    {%- if chart.sourcePending %}
    Source not yet recorded <span class="placeholder">placeholder</span>
    {%- else %}
    Source: {{ chart.source }}{% if chart.sourceYear %}, {{ chart.sourceYear }}{% endif %}
    {%- endif %}
  </p>
</figure>
