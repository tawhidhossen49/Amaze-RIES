---
title: "Contact"
description: "Get in touch with ARIES — Amaze Research, Innovation and Exploration Society."
permalink: "contact.html"
activeSection: "contact"
layout: layouts/base.njk
---
<section class="page-hero page-hero--cover">
  <div class="hero-media">
    <img src="assets/img/photo/hero-contact.jpg" srcset="assets/img/photo/hero-contact@sm.jpg 1100w, assets/img/photo/hero-contact.jpg 2000w" sizes="100vw" width="2000" height="1125" alt="" fetchpriority="high" decoding="async">
  </div>
  <div class="container">
    <p class="breadcrumb"><a href="index.html">Home</a> / Contact</p>
    <p class="eyebrow">Contact</p>
    <h1 data-split data-split-delay="120">Get in touch</h1>
    <p class="lede">Contact details below are placeholders <span class="placeholder">placeholder</span>. The guidebook does
    not supply a real email, phone number, or address for ARIES specifically. Replace
    before launch.</p>
  </div>
</section>

<section class="section section--paper">
  <div class="container contact-grid">
    <div>
      <div class="contact-item">
        <p class="c-label">Email</p>
        <p class="c-value">{{ contact.email }}{% if contact.pending %} <span class="placeholder">placeholder</span>{% endif %}</p>
      </div>
      <div class="contact-item">
        <p class="c-label">Phone</p>
        <p class="c-value">{{ contact.phone }}{% if contact.pending %} <span class="placeholder">placeholder</span>{% endif %}</p>
      </div>
      <div class="contact-item">
        <p class="c-label">Address</p>
        <p class="c-value">{{ contact.address }}{% if contact.pending %} <span class="placeholder">placeholder</span>{% endif %}</p>
      </div>
      <div class="contact-item">
        <p class="c-label">Legal</p>
        <p class="c-value">
          <a href="https://www.amazeconsortium.org/tos">Terms &amp; conditions</a>
          &nbsp;&middot;&nbsp;
          <a href="https://www.amazeconsortium.org/privacy">Privacy policy</a>
        </p>
      </div>
    </div>

    <div>
      <div class="placeholder-block u-mb-24" data-reveal="up">
        This form is not connected to a mailbox yet <span class="placeholder">placeholder</span>. It will validate what you type but cannot send it. Connect it to an email service
        before launch.
      </div>
      <form data-contact-form novalidate>
        <div class="form-grid">
          <div class="field">
            <label for="c-name">Name</label>
            <input id="c-name" type="text" name="name" autocomplete="name" required data-label="name">
            <p class="field-error" id="c-name-error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="c-email">Email</label>
            <input id="c-email" type="email" name="email" autocomplete="email" required data-label="email address">
            <p class="field-error" id="c-email-error" aria-live="polite"></p>
          </div>
          <div class="field full">
            <label for="c-subject">Subject</label>
            <input id="c-subject" type="text" name="subject">
            <p class="field-error" aria-live="polite"></p>
          </div>
          <div class="field full">
            <label for="c-message">Message</label>
            <textarea id="c-message" name="message" required data-label="message"></textarea>
            <p class="field-error" aria-live="polite"></p>
          </div>
        </div>
        <noscript>
          <p class="form-noscript">
            JavaScript is required to send this message from this page. Please email us
            directly at <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
            <span class="placeholder">placeholder</span> instead.
          </p>
        </noscript>
        <button class="btn btn-primary" type="submit"><span class="btn-label"><span>Send message</span><span aria-hidden="true">Send message</span></span></button>
        <p class="form-status" data-form-status role="status" tabindex="-1"></p>
      </form>
    </div>
  </div>
</section>
